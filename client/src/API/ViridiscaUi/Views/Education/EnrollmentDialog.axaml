<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ViridiscaUi.ViewModels.Education"
             xmlns:controls="using:ViridiscaUi.Controls"
             xmlns:local="clr-namespace:ViridiscaUi.Converters"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:Class="ViridiscaUi.Views.Education.EnrollmentDialog"
             x:DataType="vm:EnrollmentDialogViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="{Binding DialogTitle}" 
                   FontSize="20" 
                   FontWeight="Bold"
                   Margin="16"/>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Margin="16,0">
            <StackPanel Spacing="16">
                <!-- Course -->
                <StackPanel>
                    <TextBlock Text="Курс" Margin="0,0,0,4"/>
                    <controls:SearchableDropdown Items="{Binding AvailableCourses}"
                                               SelectedItem="{Binding Course}"
                                               PlaceholderText="Выберите курс..."/>
                </StackPanel>

                <!-- Student -->
                <StackPanel>
                    <TextBlock Text="Студент" Margin="0,0,0,4"/>
                    <controls:SearchableDropdown Items="{Binding AvailableStudents}"
                                               SelectedItem="{Binding Student}"
                                               PlaceholderText="Выберите студента..."/>
                </StackPanel>

                <!-- Status -->
                <StackPanel>
                    <TextBlock Text="Статус" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Status, Converter={x:Static local:EnumToCollectionConverter.Instance}}"
                             SelectedItem="{Binding Status}"/>
                </StackPanel>

                <!-- Enrollment Date -->
                <StackPanel>
                    <TextBlock Text="Дата зачисления" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding EnrollmentDate, Converter={x:Static local:DateTimeToDateTimeOffsetConverter.Instance}}"/>
                </StackPanel>

                <!-- Completion Date -->
                <StackPanel>
                    <TextBlock Text="Дата завершения" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding CompletionDate, Converter={x:Static local:DateTimeToDateTimeOffsetConverter.Instance}}"/>
                </StackPanel>

                <!-- Is Active -->
                <StackPanel>
                    <CheckBox Content="Активно" IsChecked="{Binding IsActive}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="16">
            <Button Command="{Binding CancelCommand}" 
                    Content="Отмена"/>
            <Button Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsValid}"
                    Content="Сохранить"/>
        </StackPanel>
    </Grid>
</UserControl> 


<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ViridiscaUi.ViewModels.Education"
        xmlns:controls="using:ViridiscaUi.Controls"
        xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:local="clr-namespace:ViridiscaUi.Converters"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="650"
        x:Class="ViridiscaUi.Views.Education.GradeDialog"
        x:DataType="vm:GradeDialogViewModel"
        Title="{Binding Title}"
        Width="500" Height="650"
        MinWidth="450" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        CanResize="true">
    
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
            <material:MaterialIcon Kind="Grade" Width="24" Height="24" Foreground="{DynamicResource SystemAccentColor}"/>
            <TextBlock Text="{Binding Title}" 
                       FontSize="20" 
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Margin="0,0,0,20">
            <StackPanel Spacing="20">
                <!-- Assignment and Student Information -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Основная информация" 
                                   FontWeight="SemiBold" 
                                   FontSize="16"
                                   Foreground="{DynamicResource SystemAccentColor}"/>
                        
                        <!-- Assignment -->
                        <StackPanel>
                            <TextBlock Text="Задание *" Margin="0,0,0,4" FontWeight="Medium"/>
                            <ComboBox ItemsSource="{Binding AvailableAssignments}"
                                      SelectedItem="{Binding Assignment}"
                                      PlaceholderText="Выберите задание..."
                                      DisplayMemberBinding="{Binding Title}"
                                      Classes="modern"/>
                        </StackPanel>

                        <!-- Student -->
                        <StackPanel>
                            <TextBlock Text="Студент *" Margin="0,0,0,4" FontWeight="Medium"/>
                            <ComboBox ItemsSource="{Binding AvailableStudents}"
                                      SelectedItem="{Binding Student}"
                                      PlaceholderText="Выберите студента..."
                                      DisplayMemberBinding="{Binding Person.FullName}"
                                      Classes="modern"/>
                        </StackPanel>

                        <!-- Teacher -->
                        <StackPanel>
                            <TextBlock Text="Преподаватель *" Margin="0,0,0,4" FontWeight="Medium"/>
                            <ComboBox ItemsSource="{Binding AvailableTeachers}"
                                      SelectedItem="{Binding Teacher}"
                                      PlaceholderText="Выберите преподавателя..."
                                      DisplayMemberBinding="{Binding Person.FullName}"
                                      Classes="modern"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Grade Information -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Оценка" 
                                   FontWeight="SemiBold" 
                                   FontSize="16"
                                   Foreground="{DynamicResource SystemAccentColor}"/>
                        
                        <Grid ColumnDefinitions="*,20,*">
                            <!-- Value -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Оценка *" Margin="0,0,0,4" FontWeight="Medium"/>
                                <NumericUpDown Value="{Binding Value}"
                                             Minimum="0"
                                             Maximum="5"
                                             Increment="0.5"
                                             FormatString="F1"
                                             Classes="modern"/>
                            </StackPanel>

                            <!-- Graded At -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Дата оценки *" Margin="0,0,0,4" FontWeight="Medium"/>
                                <DatePicker SelectedDate="{Binding GradedAt, Converter={x:Static local:DateTimeToDateTimeOffsetConverter.Instance}}"
                                           Classes="modern"/>
                            </StackPanel>
                        </Grid>

                        <!-- Comment -->
                        <StackPanel>
                            <TextBlock Text="Комментарий" Margin="0,0,0,4" FontWeight="Medium"/>
                            <TextBox Text="{Binding Comment}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    Height="100"
                                    Watermark="Комментарий к оценке"
                                    Classes="modern"/>
                        </StackPanel>

                        <!-- Is Active -->
                        <CheckBox Content="Оценка активна" 
                                  IsChecked="{Binding IsActive}"
                                  Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Validation Errors -->
                <Border IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Background="{DynamicResource SystemFillColorCriticalBrush}"
                        BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon Kind="AlertCircle" 
                                               Width="16" Height="16" 
                                               Foreground="White"
                                               VerticalAlignment="Top"
                                               Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding ValidationError}" 
                                   Foreground="White"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" 
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right"
                        Spacing="12">
                <Button Command="{Binding CancelCommand}" 
                        Content="Отмена"
                        Classes="secondary"
                        Width="100"/>
                <Button Command="{Binding SaveCommand}"
                        Content="Сохранить"
                        Classes="primary"
                        Width="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window> 

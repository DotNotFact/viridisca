<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:ViridiscaUi.Controls"
             xmlns:vm="using:ViridiscaUi.ViewModels.System"
             xmlns:converters="using:ViridiscaUi.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ViridiscaUi.Views.System.DepartmentView">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <Button Classes="btn,btn-primary" Command="{Binding CreateCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource plus_regular}" />
                        <TextBlock Text="Создать кафедру" />
                    </StackPanel>
                </Button>
                <Button Classes="btn,btn-secondary" Command="{Binding EditCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource edit_regular}" />
                        <TextBlock Text="Редактировать" />
                    </StackPanel>
                </Button>
                <Button Classes="btn,btn-danger" Command="{Binding DeleteCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource delete_regular}" />
                        <TextBlock Text="Удалить" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <controls:SearchableDropdown Width="300" 
                                          Items="{Binding Items}"
                                          SelectedItem="{Binding SelectedItem}"
                                          AddCommand="{Binding CreateCommand}" />
                <Button Classes="btn,btn-secondary" Command="{Binding RefreshCommand}">
                    <PathIcon Data="{StaticResource refresh_regular}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <!-- Table Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,8">
                <TextBlock Grid.Column="0" Text="Код" FontWeight="Bold" Width="100" />
                <TextBlock Grid.Column="1" Text="Название" FontWeight="Bold" />
                <TextBlock Grid.Column="2" Text="Родительская кафедра" FontWeight="Bold" Width="200" />
                <TextBlock Grid.Column="3" Text="Преподаватели" FontWeight="Bold" Width="100" />
                <TextBlock Grid.Column="4" Text="Действия" FontWeight="Bold" Width="100" />
            </Grid>

            <!-- Table Content -->
            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,4">
                                <TextBlock Grid.Column="0" Text="{Binding Code}" Width="100" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                <TextBlock Grid.Column="2" Text="{Binding ParentDepartment.Name}" Width="200" />
                                <TextBlock Grid.Column="3" Text="{Binding TeachersCount}" Width="100" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" Width="100">
                                    <Button Classes="btn,btn-icon" Command="{Binding $parent[UserControl].DataContext.EditCommand}">
                                        <PathIcon Data="{StaticResource edit_regular}" />
                                    </Button>
                                    <Button Classes="btn,btn-icon,btn-danger" Command="{Binding $parent[UserControl].DataContext.DeleteCommand}">
                                        <PathIcon Data="{StaticResource delete_regular}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="16,0,0,0">
            <TextBlock Grid.Column="0" 
                       Text="{Binding TotalItems, StringFormat='Всего кафедр: {0}'}" 
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Classes="btn,btn-secondary" 
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CurrentPage, Converter={x:Static converters:GreaterThanConverter.Instance}, ConverterParameter=1}">
                    <PathIcon Data="{StaticResource chevron_left_regular}" />
                </Button>
                <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" />
                <Button Classes="btn,btn-secondary" 
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding HasNextPage}">
                    <PathIcon Data="{StaticResource chevron_right_regular}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="{StaticResource ModalOverlayBrush}"
                IsVisible="{Binding IsLoading}">
            <ProgressBar IsIndeterminate="True" 
                        Width="100" 
                        Height="4" 
                        VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl> 

